{
  "name": "hanab-mobile",
  "version": "1.0.0-beta.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "preandroid": "expo prebuild --platform android --no-install",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "bot:add": "node tools/add-bot.mjs",
    "bot:check": "node tools/add-bot.mjs --check",
    "cards:generate": "node tools/card-assets/generate.mjs",
    "cards:check": "node tools/card-assets/generate.mjs --check",
    "android:beta-apk": "node tools/build-android-beta.mjs",
    "validate": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "complete-common": "2.22.1",
    "expo": "~57.0.18",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "immer": "11.1.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-redux": "^9.3.0",
    "tslib": "2.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "~19.2.2",
    "jest-expo": "57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.cache/",
      "/src/game/upstream/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|immer))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "private": true
}
